# Aavin OCR & Automated Email Reporting Configuration

# Server & Storage
OCR_DATA_DIR=data
OCR_MODEL_DIR=models
OCR_MAX_UPLOAD_MB=25

# SMTP Server Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Aavin OCR Reports
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Email Dispatch Recipients (comma-separated for multiples)
REPORT_EMAIL_TO=
REPORT_EMAIL_CC=
REPORT_EMAIL_BCC=

# Feature Flags & Localization
REPORT_EMAIL_ENABLED=false
REPORT_TIMEZONE=Asia/Kolkata
